LDSCRIPT = arch/powerpc/scripts/openfirmware.lds
SRCDIRS += interface/openfirmware
SRCDIRS := $(filter-out drivers/%,$(SRCDIRS))
SRCS += drivers/bus/pci.c drivers/bus/pci_settings.c drivers/net/intel.c drivers/nvs/nvs.c
NON_AUTO_MEDIA += of
$(BIN)/%.of : $(BIN)/%.of.tmp
	$(CP) $< $@
LDFLAGS += --undefined=_of_start
DRIVERS_none := platform
DRIVERS_ipxe += ofnet intel pci
